<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <!-- Rich Crimson Maroon Gradients -->
    <linearGradient id="maroonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7B2329"/>
      <stop offset="100%" stop-color="#58161B"/>
    </linearGradient>
    <linearGradient id="goldSwoosh" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FDBA31"/>
      <stop offset="50%" stop-color="#F0A31D"/>
      <stop offset="100%" stop-color="#D98A0E"/>
    </linearGradient>
    <linearGradient id="silverSwoosh" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E2E8F0"/>
      <stop offset="100%" stop-color="#CBD5E1"/>
    </linearGradient>
  </defs>

  <!-- Background Base Disc -->
  <circle cx="200" cy="200" r="195" fill="#FAF7F2" />

  <!-- Outer Maroon Circular Ring -->
  <circle cx="200" cy="200" r="178" fill="none" stroke="#681F25" stroke-width="14" />

  <!-- Horizontal Baseline extending from book through right circle edge -->
  <path d="M 125 296 L 368 296 L 368 308 L 125 308 Z" fill="#681F25" />

  <!-- LEFT BOOK COVER & SPINE -->
  <!-- Outer Maroon Spine & Base -->
  <path d="M 96 122 
           L 78 130 
           L 125 308 
           L 148 308 
           L 142 296 
           L 110 136 Z" 
        fill="#681F25" />

  <!-- Left Open Pages (Fan of Knowledge) -->
  <!-- Page 1 (Subtle Shadow Gray) -->
  <polygon points="102,135 116,130 148,294 136,296" fill="#94A3B8" opacity="0.65"/>
  
  <!-- Page 2 (Light Grayish-White) -->
  <polygon points="116,130 132,126 160,290 146,294" fill="#E2E8F0" />
  
  <!-- Page 3 (Crisp White) -->
  <polygon points="132,126 148,123 172,286 158,290" fill="#FFFFFF" />
  
  <!-- Page 4 (Gutter Page) -->
  <polygon points="148,123 164,121 184,282 170,286" fill="#F8FAFC" />

  <!-- Page subtle division strokes on left -->
  <line x1="116" y1="130" x2="146" y2="294" stroke="#CBD5E1" stroke-width="1.5" />
  <line x1="132" y1="126" x2="158" y2="290" stroke="#CBD5E1" stroke-width="1.5" />
  <line x1="148" y1="123" x2="170" y2="286" stroke="#E2E8F0" stroke-width="1.5" />

  <!-- RIGHT OPEN BOOK SWOOSHES -->
  <!-- 1. Top Silver Page Swoosh -->
  <path d="M 174 250 
           C 184 205 218 168 288 182
           C 298 184 305 187 310 191
           C 284 204 258 216 230 225
           C 204 233 186 243 174 250 Z" 
        fill="url(#silverSwoosh)" />

  <!-- 2. Middle Vibrant Gold Swoosh (Focal Accent) -->
  <path d="M 170 266 
           C 188 228 230 210 312 222
           C 322 224 328 227 332 231
           C 300 247 264 258 228 264
           C 198 269 180 268 170 266 Z" 
        fill="url(#goldSwoosh)" />

  <!-- 3. Bottom Base Page (White/Soft Grey) -->
  <path d="M 166 282 
           C 195 271 238 267 330 272
           C 314 285 278 293 230 295
           C 195 296 176 290 166 282 Z" 
        fill="#FFFFFF" stroke="#E2E8F0" stroke-width="1" />

  <!-- Central Gutter / Spine Accent -->
  <path d="M 160 278 
           C 165 285 170 292 174 296
           L 170 299
           C 165 295 158 286 154 280 Z" 
        fill="#681F25" />

  <!-- THE SOARING BIRD (Maroon Emblem of Wisdom) -->
  <g fill="#681F25">
    <!-- Bird Head & Beak -->
    <path d="M 196 112 
             C 190 108 184 110 179 114
             C 175 117 167 119 163 117
             C 166 122 172 125 177 125
             C 179 128 184 132 190 132
             C 194 129 197 121 196 112 Z" />
    
    <!-- Bird Body -->
    <path d="M 188 126 
             C 194 138 198 154 197 174
             C 193 162 188 148 184 138
             C 184 133 186 129 188 126 Z" />

    <!-- Bird Tail Feathers (3 plumes pointing gracefully downwards towards book) -->
    <!-- Left Tail Plume -->
    <path d="M 188 162 
             C 184 176 176 188 167 197
             C 173 186 181 174 187 162 Z" />
    <!-- Center Tail Plume -->
    <path d="M 192 165 
             C 194 182 194 198 192 212
             C 189 196 189 180 190 165 Z" />
    <!-- Right Tail Plume -->
    <path d="M 195 162 
             C 201 176 208 188 217 197
             C 210 186 203 174 197 162 Z" />

    <!-- Left Wing (Spread upwards & left with distinct layered flight feathers) -->
    <path d="M 186 122 
             C 176 112 160 98 138 88
             C 144 96 151 105 155 114
             C 144 100 129 86 110 76
             C 118 85 127 96 132 108
             C 120 93 103 78 82 68
             C 93 80 103 94 109 110
             C 92 92 73 79 50 68
             C 63 84 78 102 86 124
             C 73 109 58 99 38 90
             C 53 110 68 132 82 156
             C 108 147 142 138 178 134 Z" />

    <!-- Right Wing (Spread upwards & right with distinct layered flight feathers) -->
    <path d="M 196 122 
             C 208 112 228 98 254 88
             C 248 96 239 105 233 114
             C 248 100 267 86 288 76
             C 278 85 268 96 261 108
             C 278 93 300 78 324 68
             C 311 80 299 94 290 110
             C 311 92 334 79 360 68
             C 345 84 328 102 318 124
             C 335 109 352 99 372 90
             C 355 110 338 132 322 156
             C 292 147 254 138 204 134 Z" />
  </g>

</svg>